# ReliefTrace Lambda Container Image for AWS Lambda
FROM public.ecr.aws/lambda/python:3.12

# Install GEOS library for Shapely if needed
RUN microdnf install -y gcc geos geos-devel && microdnf clean all

# Copy requirements and install
COPY requirements.txt ${LAMBDA_TASK_ROOT}/
RUN pip install --no-cache-dir -r ${LAMBDA_TASK_ROOT}/requirements.txt

# Copy application source code
COPY backend/ ${LAMBDA_TASK_ROOT}/backend/
COPY data/geo/ ${LAMBDA_TASK_ROOT}/data/geo/

# Environment defaults for Team 56 (ap-south-1)
ENV AWS_DEFAULT_REGION=ap-south-1 \
    RT_S3_BUCKET=fai-tce-team56-images \
    RT_DYNAMODB_TABLE=fai-tce-team56-claims \
    RT_GEO_DIR=${LAMBDA_TASK_ROOT}/data/geo

# Set the Lambda handler
CMD ["backend.main.handler"]
