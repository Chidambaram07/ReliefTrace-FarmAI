# --- Dataset (Phase 1) ---
RT_CSV_PATH=data/raw/Ground_truth_Points.csv
RT_IMAGES_DIR=data/images
RT_DB_PATH=data/processed/reliefTrace.db

# --- Storage & Uploads ---
STORAGE_BACKEND=local
# For AWS deployment / S3 mode:
# STORAGE_BACKEND=s3
# S3_BUCKET=fai-tce-team56-images
RT_UPLOAD_DIR=data/uploads
RT_MAX_UPLOAD_MB=5
RT_CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:3000
RT_LOG_LEVEL=INFO

# --- AWS Bedrock (Phase 3) ---
# NEVER put access keys in this file. Use `aws configure sso` / AWS_PROFILE, or the default credential chain.
AWS_REGION=ap-south-1
# AWS_PROFILE=your-sso-profile
# If the base ID is rejected, the service automatically tries the "apac." profile ID. Run scripts/check_bedrock.py.
BEDROCK_VISION_MODEL_ID=amazon.nova-lite-v1:0
BEDROCK_TEXT_MODEL_ID=amazon.nova-micro-v1:0
BEDROCK_MAX_IMAGE_SIDE=1024

# --- Model registry (model availability + abstraction) ---
# Nova Lite/Micro above: CONFIRMED invokable in this account via the 'apac.' cross-region profile.
# Ministral ids below are copied verbatim from AWS's Bedrock User Guide "Programmatic Access" table
# and CONFIRMED invokable in this account (2026-09-27). No cross-region profile exists for them
# (AWS docs state Geo/Global inference = "Not supported"), so the base id is used directly.
MINISTRAL_3B_MODEL_ID=mistral.ministral-3-3b-instruct
MINISTRAL_8B_MODEL_ID=mistral.ministral-3-8b-instruct
TITAN_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
# Confirmed invokable in this account; used by the image-retrieval tool (visual similarity search
# against the challenge dataset), not by the core claim-analysis pipeline.
TITAN_MULTIMODAL_EMBED_MODEL_ID=amazon.titan-embed-image-v1
# Per-model opt-out switches (default true). Disabling here means "never invoked", distinct from
# "not_configured" (no id known) - see backend/services/model_health.py.
# MODEL_NOVA_LITE_ENABLED=true
# MODEL_NOVA_MICRO_ENABLED=true
# MODEL_MINISTRAL_3B_ENABLED=true
# MODEL_MINISTRAL_8B_ENABLED=true
# MODEL_TITAN_EMBED_ENABLED=true
# MODEL_TITAN_MULTIMODAL_EMBED_ENABLED=true
# Optional list prices (USD per 1M tokens) so the app can show ESTIMATED cost. Leave unset to show tokens only.
# RT_PRICE_VISION_IN_PER_M=
# RT_PRICE_VISION_OUT_PER_M=
# RT_PRICE_TEXT_IN_PER_M=
# RT_PRICE_TEXT_OUT_PER_M=

# --- Evidence / verification (Phase 4-5) ---
RT_GEO_DIR=data/geo
# Open-Meteo archive API is free/no key. Override only for testing.
# RT_WEATHER_URL=https://archive-api.open-meteo.com/v1/archive

# --- Image retrieval index (Titan Multimodal Embeddings G1) ---
# Valid output lengths for titan-embed-image-v1: 256, 384, 1024. Vectors are stored with their dim,
# so changing this later means rebuilding the index (scripts/build_image_index.py).
TITAN_IMAGE_EMBED_DIM=256
